    {
      "name": "isDiffOrNew",
      "parameters": {
        "jsCode": "const items = $input.all();\nlet githubItem = items[0] && items[0].json ? items[0].json : {};\nlet n8nItem = items[1] && items[1].json ? items[1].json : {};\n\nfunction cleanAndSort(obj) {\n  if (obj === null || typeof obj !== 'object') {\n    return obj;\n  }\n  if (Array.isArray(obj)) {\n    // Limpiamos cada elemento del array\n    let mapped = obj.map(cleanAndSort);\n    // Si el array tiene objetos con la propiedad 'name' (como los nodos de n8n), los ordenamos por nombre\n    if (mapped.length > 0 && typeof mapped[0] === 'object' && mapped[0] !== null && 'name' in mapped[0]) {\n      mapped.sort((a, b) => (a.name > b.name) ? 1 : ((b.name > a.name) ? -1 : 0));\n    }\n    return mapped;\n  }\n  \n  const sortedKeys = Object.keys(obj).sort();\n  const result = {};\n  for (const key of sortedKeys) {\n    // Filtramos campos dinámicos que n8n pueda cambiar solos\n    if (key === 'updatedAt' || key === 'versionId' || key === 'meta' || key === 'id') continue;\n    \n    result[key] = cleanAndSort(obj[key]);\n  }\n  return result;\n}\n\nconst fileExistsOnGitHub = githubItem.sha && githubItem.sha.length > 0;\n\nif (fileExistsOnGitHub) {\n  try {\n    let decodedString = Buffer.from(githubItem.content, 'base64').toString('utf8');\n    var origWorkflow = JSON.parse(decodedString);\n    \n    var orderedOriginal = cleanAndSort(origWorkflow);\n    var orderedActual = cleanAndSort(n8nItem);\n\n    let stringOriginal = JSON.stringify(orderedOriginal);\n    let stringActual = JSON.stringify(orderedActual);\n\n    if (stringOriginal === stringActual) {\n      githubItem.github_status = \"same\";\n    } else {\n      githubItem.github_status = \"different\";\n      githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n    }\n  } catch (e) {\n    githubItem.github_status = \"different\";\n    githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n} else {\n  var orderedActual = cleanAndSort(n8nItem);\n  githubItem.github_status = \"new\";\n  githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn [{ json: githubItem }];"
      },
