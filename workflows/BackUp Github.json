    {
      "id": "f3dbfd50-360d-45ee-9e12-36d6e59d8f1e",
      "name": "isDiffOrNew",
      "parameters": {
        "jsCode": "const items = $input.all();\nlet githubItem = items[0] && items[0].json ? items[0].json : {};\nlet n8nItem = items[1] && items[1].json ? items[1].json : {};\n\n// Función recursiva para ordenar todas las propiedades y arrays de un objeto\nfunction deepSortObject(obj) {\n  if (obj === null || typeof obj !== 'object') {\n    return obj;\n  }\n  if (Array.isArray(obj)) {\n    return obj.map(deepSortObject);\n  }\n  const sortedKeys = Object.keys(obj).sort();\n  const result = {};\n  for (const key of sortedKeys) {\n    result[key] = deepSortObject(obj[key]);\n  }\n  return result;\n}\n\nconst fileExistsOnGitHub = githubItem.sha && githubItem.sha.length > 0;\n\nif (fileExistsOnGitHub) {\n  try {\n    let decodedString = Buffer.from(githubItem.content, 'base64').toString('utf8');\n    var origWorkflow = JSON.parse(decodedString);\n    \n    // Aplicamos ordenamiento profundo y estricto a ambos\n    var orderedOriginal = deepSortObject(origWorkflow);\n    var orderedActual = deepSortObject(n8nItem);\n\n    if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n      githubItem.github_status = \"same\";\n    } else {\n      githubItem.github_status = \"different\";\n      githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n    }\n  } catch (e) {\n    githubItem.github_status = \"different\";\n    githubItem.n8n_data_stringy = JSON.stringify(n8nItem, null, 2);\n  }\n} else {\n  var orderedActual = deepSortObject(n8nItem);\n  githubItem.github_status = \"new\";\n  githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn [{ json: githubItem }];"
      },
      "position": [
        -1424,
        -416
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 1
    },
