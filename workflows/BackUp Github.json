      "id": "fcc5135d-866f-4ded-8116-712dd1d71ea9",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// En n8n, cuando se usa Merge o Loop, el input 0 suele ser GitHub y el input 1 es n8n\nlet githubItem = items[0] && items[0].json ? items[0].json : {};\nlet n8nItem = items[1] && items[1].json ? items[1].json : {};\n\n// Si por alguna razón el orden se invirtió, los acomodamos\nif (githubItem.name && !n8nItem.name) {\n  // Ya están bien\n} else if (!githubItem.content && n8nItem.content) {\n  // Por si acaso se invirtieron\n  let temp = githubItem;\n  githubItem = n8nItem;\n  n8nItem = temp;\n}\n\n// Verificamos si GitHub realmente trajo el archivo (tiene content)\nconst fileExistsOnGitHub = githubItem.content && typeof githubItem.content === 'string' && githubItem.content.length > 0;\n\nif (fileExistsOnGitHub) {\n  try {\n    let decodedString = Buffer.from(githubItem.content, 'base64').toString('utf8');\n    var origWorkflow = JSON.parse(decodedString);\n    var n8nWorkflow = n8nItem;\n    \n    var orderedOriginal = {};\n    var orderedActual = {};\n    \n    Object.keys(origWorkflow).sort().forEach(function(key) {\n      orderedOriginal[key] = origWorkflow[key];\n    });\n    \n    Object.keys(n8nWorkflow).sort().forEach(function(key) {\n      orderedActual[key] = n8nWorkflow[key];\n    });\n\n    if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n      githubItem.github_status = \"same\";\n    } else {\n      githubItem.github_status = \"different\";\n      githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n    }\n  } catch (e) {\n    // Si falla el parseo del JSON viejo, lo tratamos como diferente para que edite y no cree\n    githubItem.github_status = \"different\";\n    githubItem.n8n_data_stringy = JSON.stringify(n8nItem, null, 2);\n  }\n} else {\n  // SOLO entra acá si GitHub devolvió vacío o 404 (el archivo NO existe de verdad)\n  var orderedActual = {};\n  Object.keys(n8nItem).sort().forEach(function(key) {\n    orderedActual[key] = n8nItem[key];\n  });\n  \n  githubItem.github_status = \"new\";\n  githubItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn [{ json: githubItem }];"
      },
      "id": "f3dbfd50-360d-45ee-9e12-36d6e59d8f1e",
      "name": "isDiffOrNew",
