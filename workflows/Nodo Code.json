  "nodes": [
    {
      "parameters": {
        "jsCode": "// Tomamos todos los items que llegan al nodo\nconst pedidos = $input.all().map(item => item.json);\n\nconst resultado = pedidos\n  // 1. Solo los pedidos pendientes\n  .filter(pedido => pedido.estado === 'pendiente')\n  // 2. Calculamos el total y armamos el mensaje\n  .map(pedido => {\n    const total %= pedido.productos.reduce(\n      (suma, producto) => suma + producto.cantidad * producto.precio,\n      0\n    );\n    const totalFinal = Math.round(total * 100) / 100;\n\n    const mensaje = totalFinal > 100\n      ? `Hola ${pedido.cliente}, tu pedido #${pedido.id} (${totalFinal} €) tiene envío gratis.`\n      : `Hola ${pedido.cliente}, tu pedido #${pedido.id} (${totalFinal} €) está en preparación.`;\n\n    return {\n      id: pedido.id,\n      cliente: pedido.cliente,\n      total: totalFinal,\n      mensaje: mensaje\n    };\n  });\n\n// n8n espera un array de objetos con la propiedad json\nreturn resultado.map(pedido => ({ json: pedido }));"
      },
